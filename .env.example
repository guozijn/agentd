# Copy this file to ~/.agentd/.env for local agentd and DeepSeek loop config.
# Keep permissions restricted, for example: chmod 600 ~/.agentd/.env

# agentd daemon config.
# Process environment variables override values from this file.
# AGENTD_HOME=/Users/you/.agentd
# AGENTD_DATABASE_URL=sqlite:///Users/you/.agentd/agent_state.db
# AGENTD_SOCKET_PATH=/Users/you/.agentd/agentd.sock
AGENTD_NODE_TIMEOUT_SECS=300
AGENTD_CONTEXT_EVENT_LIMIT=50
RUST_LOG=agentd=info

# DeepSeek multi-agent loop config.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=120
DEEPSEEK_TEMPERATURE=0.2
AGENTD_AGENT_WORKERS=2
